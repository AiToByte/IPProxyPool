    /// `trace_id` 缺失（老 JSON 无此字段）时必须是空串，**不得 panic、不得
    /// 编造**。空串如实表达「该事件产生时未打点」——排障时看到空串应理解为
    /// 「这条老数据没有 trace」，而不是「trace 丢了」。
    #[test]
    fn row_from_event_tolerates_missing_trace_id() {
        let e = crate::telemetry::TelemetryEvent {
