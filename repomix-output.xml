/// Admin API 端点未直接读取，保留以供后续扩展（如在节点/租户详情中
/// 关联实时指标）。
#[allow(dead_code)]
pub struct AdminState {
    pub router: Arc<RouterEngine>,
    /// 步骤 52：托管节点注册表（运行时增删 + 持久化）。
    ///
