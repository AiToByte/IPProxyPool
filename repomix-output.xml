        // 透传而非重新生成：两边必须是**同一个** ID，否则「同键互查」不成立。
        assert_eq!(
            row.trace_id, "1700000000123-4242-7",
            "trace_id 必须原样透传到仓库行；重新生成会让日志与仓库对不上"
