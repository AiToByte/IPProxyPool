impl Health {
    /// P3 复合分（ProxyStats 方法学可落地子集）：成功率×延迟惩罚（score 本体冻结）
    /// ×留存因子（streak≥3 满 1；ProxyStats 会话保持 72~97% 的连续映射，不搞硬阈值抖动）。
    pub fn composite(&self) -> f64 {
        let retention = 0.5 + 0.5 * ((self.streak as f64) / (TRUSTED_MIN_STREAK as f64)).min(1.0);
        self.score() * retention
    }
    // weight() 内 self.score() → self.composite()（cap/保底逻辑不动）。
}
```

