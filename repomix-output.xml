    reg.upsert_full(&raw("10.0.0.2", "a"), 50, AnonLevel::Elite, None, now);
    // 灌第三个→淘汰最低分之一（初分相同，允许淘汰任一，但总数恒 2）。
    reg.upsert_full(&raw("10.0.0.3", "a"), 50, AnonLevel::Elite, None, now);
