    pub tenant_id: String,
    pub api_key: String,
    pub is_active: bool,
    pub qps: u32,
    pub max_concurrency: usize,
    pub in_flight: usize,
    pub total_bytes: u64,
    pub balance_usd: f64,
}

/// Admin API 租户详情（与 TenantSummary 同形态，保留扩展字段的位置，便于未来追加）。
#[derive(Debug, Clone, Serialize, Deserialize, utoipa::ToSchema)]
pub struct TenantDetail {
    pub tenant_id: String,
    pub api_key: String,
