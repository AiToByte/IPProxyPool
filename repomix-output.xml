    let first = arm_for(&arms, &node);
    assert_eq!(first.key, node.addr, "臂键必须是 node.addr");
    assert_eq!(first.tier, "residential", "臂档位取自节点");
    assert_eq!(arms.len(), 1);

    // 热路径：命中，且必须返回**同一个** Arc（不是等价的副本）。
    let second = arm_for(&arms, &node);
