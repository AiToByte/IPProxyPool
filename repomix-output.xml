/// 语义回归：命中与未命中都要返回**可用**的臂，且键为 `node.addr`。
#[test]
fn opt_r10_b1_arm_for_hit_and_miss_semantics() {
    let arms: DashMap<String, Arc<BanditArm>> = DashMap::new();
