fn bandit_context_reuses_preset_without_recompute() {
    // R2-6：ctx 预置则原样复用（哨兵值不可能是现算结果：bias 恒 1.0/prior 恒 0.2）；
    // 为空则现算且形态正确（选学一致 + 省 syscall 的接线锁定）。
    let engine = LinUCBEngine::new(0.4);
