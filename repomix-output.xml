fn header_with(pairs: &[(&'static str, &'static str)]) -> RequestHeader {
    let mut h = RequestHeader::build("GET", b"/", None).unwrap();
    for (k, v) in pairs {
        h.insert_header(*k, *v).unwrap();
    }
    h
}

