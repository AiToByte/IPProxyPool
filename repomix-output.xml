    assert!(slow.score() < h.score(), "latency penalty must bite");
    assert!(slow.weight() < 20);
    let mut bad = Health::fresh();
    for _ in 0..10 { bad.note_failure(); }
    assert_eq!(bad.weight(), 1); // 低分保底 1（不断流，只降权）
