    volumes:
      - ./deploy/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      # C3 告警规则（rules 原生能力，无需额外 feature flag）。
      - ./deploy/prometheus/rules.yml:/etc/prometheus/rules.yml:ro
      # OPT-R7 C2：补 TSDB 持久化卷。此前 prometheus 只挂了两个只读配置文件，
      # 数据全在容器可写层 ⇒ **`docker compose up -d` 的任何一次 recreate/down-up
      # 都会清空全部历史指标**。直方图（gateway_processing_duration_ms_bucket、
      # free_pool_fwd_latency_ms_bucket）恰恰需要跨重启累计才能算 P99/均值——
      # 这是一个「以为有 observability，实际每次重启归零」的静默失效。
      - prometheus-data:/prometheus
      # OPT-R4 C9：Alertmanager 接线**已在 prometheus.yml 内完成**
      # （`alerting.alertmanagers.targets: ["alertmanager:9093"]`，
      #  见 deploy/prometheus/prometheus.yml）。
      #
      # OPT-R17 更正两处失实（此前会让人以为"接线还没做"）：
      #  ① 本条**曾**注释着「取消注释＋重启 prom 即投递」并挂着
      #     `- ./deploy/alertmanager.yml:/etc/prometheus/alertmanager.yml:ro`。
      #     那是**多余且无效**的：Alertmanager 的收件人配置由 **alertmanager
      #     容器自己**读 `/etc/alertmanager/alertmanager.yml`（见下方
      #     alertmanager 服务的 volumes），Prometheus 侧根本不需要这个文件，
      #     挂进去也不会被读取。真正需要改的是 `deploy/alertmanager.yml` 的
      #     `route.receiver`，改完重启 **alertmanager** 容器（不是 prom）。
      #  ② 故把这条误导性挂载删除，避免"照着注释操作却毫无效果"。
      #
      # 投递链路现状（OPT-R17 实测取证）：链路已通到 Alertmanager，
      # 但 `route.receiver: "empty"` 是**刻意**的空接收器（开发环境避免误报
      # 到真实渠道）⇒ **告警不会外发给人**。要真正收到通知，必须按
      # deploy/alertmanager.yml 头部说明启用 webhook 或 email 并填入
      # 真实凭据（凭据不入仓）。详见 docs/OPERATION.md §告警投递。

      # 改 alertmanager.yml 后需 restart（Prometheus 默认禁用 /-/reload，
      # 但本次改的是 alertmanager 侧配置，prom 侧**无需**重启）。

  grafana:
    image: grafana/grafana:11.1.0
    container_name: ipproxy-grafana
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: ${GF_SECURITY_ADMIN_USER:-admin}
      GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD:-change-me-in-prod}
    volumes:
      - grafana-data:/var/lib/grafana
      # Grafana provisioning-as-code: datasource + dashboard auto-load on boot
      # (named volume keeps runtime edits; fresh volume gets full observability).
      - ./deploy/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./deploy/grafana:/etc/grafana/dashboards:ro

  # C6 容器化网关（profile-gated opt-in：默认 `compose up` 行为不变，
  # 仍是宿主二进制直跑＋prom 抓宿主 :9091；冒烟见下，生产切换（prom 改抓
  # gateway:9091）是后续独立事项，本计划内不做）。
  # 冒烟：docker compose --profile gateway up -d --build gateway
  #      → curl :8916（宿主 mock 不可达时 503 空池，属预期）＋ :9091/metrics 200
  #      → docker compose --profile gateway stop gateway（宿主网关不受影响）。
  gateway:
    build: ./gateway
    profiles: ["gateway"]
    container_name: ipproxy-gateway
    # OPT-R5 O5：网关端口收回环（D3 回环缺省；局域网需敞口时用显式覆写，
    # 如 compose.override.yml 打开 0.0.0.0:8916:8916）。
    ports:
      - "127.0.0.1:8916:8916"
      - "127.0.0.1:9091:9091"
      - "127.0.0.1:9092:9092"
    environment:
      # D3：与宿主缺省一致，门默认开启（本地开发带 default_key 头）。
      REQUIRE_API_KEY: "1"
      REDIS_URL: "redis://:${REDIS_PASSWORD:-123456}@redis:6379/"
      CLICKHOUSE_URL: "http://clickhouse:8123"
      CLICKHOUSE_USER: ${CLICKHOUSE_USER:-proxy}
      CLICKHOUSE_PASSWORD: "${CLICKHOUSE_PASSWORD:-123456}"
      CLICKHOUSE_DB: ${CLICKHOUSE_DB:-proxy}
      # 容器内必须绑 0.0.0.0（D3 起宿主缺省已收 127.0.0.1，此处两者均显式覆写）。
      GATEWAY_ADDR: "0.0.0.0:8916"
      METRICS_ADDR: "0.0.0.0:9091"
      # 步骤 52：Admin API。容器内若沿用缺省 127.0.0.1:9092，宿主端口映射
      # 打到的是容器回环之外的地址，**连不上**；必须显式绑 0.0.0.0。
      ADMIN_ADDR: "0.0.0.0:9092"
      # 缺省值是开发用占位符（与 GF_SECURITY_ADMIN_PASSWORD 同口径）：
      # 任何能访问宿主 127.0.0.1:9092 的本地进程都能改节点表。生产请用
      # .env 覆盖为强随机值；留空则 fail-closed（所有 Admin 请求 401）。
      ADMIN_API_KEY: "${ADMIN_API_KEY:-change-me-admin-key}"
      # 托管节点持久化。命名卷跨 recreate/down-up 保留；免费池 free-* 与
      # TEST_POOL_NODES 不写此文件。文件含上游代理凭据（Unix 0600）。
      NODES_FILE: "/app/data/nodes.json"
    volumes:
      - gateway-data:/app/data
    depends_on:
      redis:
        condition: service_healthy
      clickhouse:
        condition: service_healthy

  # OPT-2 环境门示例（D3 起默认开启，无头 403；`REQUIRE_API_KEY=0` 显式关闭，容器/宿主通用）：
  # R2-8 配置 env 化示例（缺省沿用 main.rs code 常量，只覆盖需改项）：
  #     REQUIRE_API_KEY: "1"
  #     REDIS_URL: "redis://redis:6379/"
  #     CLICKHOUSE_URL: "http://clickhouse:8123"
  #     CLICKHOUSE_USER: "proxy"
  #     CLICKHOUSE_PASSWORD: "123456"
  #     CLICKHOUSE_DB: "proxy"
  #     GATEWAY_ADDR: "0.0.0.0:8916"
  #     METRICS_ADDR: "127.0.0.1:9091"
  #     ADMIN_ADDR: "0.0.0.0:9092"
  #     ADMIN_API_KEY: "<强随机值>"
  #     NODES_FILE: "/app/data/nodes.json"
  #     PROBE_INTERVAL_SECS: "60"
  #     SWEEP_INTERVAL_SECS: "60"
  #     ARBITRAGE_INTERVAL_SECS: "60"
  #     PREWARM_INTERVAL_SECS: "30"
  #     # FreePool 第二供应线（默认关闭；FREE_ENABLED=1 开；全量 env 见计划 §2）。
  #     FREE_ENABLED: "1"
  #     FREE_API_URLS: "https://proxylist.geonode.com/api/proxy-list?limit=100&page=1&sort_by=lastChecked&sort_type=desc"
  #     FREE_HTML_URLS: "https://free-proxy-list.net/"
  #     FREE_GITHUB_URLS: "https://raw.githubusercontent.com/clarketm/proxy-list/master/proxy-list-raw.txt"
  #     FREE_FETCH_INTERVAL_SECS: "600"
  #     FREE_TTL_SECS: "1800"
  #     FREE_VERIFY_TIMEOUT_SECS: "3"
  #     FREE_MAX_LATENCY_MS: "3000"
  #     FREE_MAX_CONCURRENT: "50"
  #     FREE_FULL_CONCURRENT: "20"
  #     FREE_MAX_NODES: "2000"
  #     FREE_FULL_CHECK_URL: "https://httpbin.org"
  #     FREE_REQUIRE_ELITE: "0"
  #     FREE_SOURCE_MAX_ZERO_CYCLES: "3"
  #     FREE_SUSPEND_RETRY_EVERY: "3"
  #     # P2 SOCKS 翻译桥（显式 X-Proxy-Proto: socks5/socks4 请求出站执行器）。
  #     SOCKS_BRIDGE_TIMEOUT_SECS: "20"
  #     SOCKS_MAX_BODY_BYTES: "10485760"
  #     # P3 GeoIP 画像（GeoLite2-City.mmdb 路径；不配即 Disabled 降级，只观察不执法）。
  #     GEOIP_MMDB_PATH: "/data/GeoLite2-City.mmdb"
  #     # P4 mismatch 执法（默认 0 只观察；库 Live＋观察无误报后再开 1）。
  #     GEOIP_ENFORCE_MISMATCH: "0"
  #     # P4 库更新产物挂载（deploy/geoip_update.py --out-dir ./data 写入宿主 ./data，网关只读挂载）：
  #     # volumes:
  #     #   - ./data:/data:ro

  # OPT-R4 C11：redis_exporter（profile-gated opt-in；镜像需联网拉取，
  # 本机 Hub 不通故默认不带；跑起后 prom 自动有 redis_stream_length 序列，
  # TelemetryStreamLagGrowing 规则自动生效）。
  # 用法：docker compose --profile observability up -d redis-exporter
  redis-exporter:
    image: oliver006/redis_exporter:v1.66.0
    profiles: ["observability"]
    container_name: ipproxy-redis-exporter
    ports:
      - "127.0.0.1:9121:9121"
    environment:
      REDIS_ADDR: "redis://redis:6379"
      REDIS_PASSWORD: "${REDIS_PASSWORD:-123456}"
      CHECK_SINGLE_KEYS: "stream:proxy:telemetry"
    depends_on:
      redis:
        condition: service_healthy

  # OPT-R5 O9：alertmanager。
  #
  # OPT-R17：去掉 `profiles: ["observability"]` —— 此前 profile-gated 意味着
  # `docker compose up -d` **不起**它，而 prometheus.yml 的 `alerting:` 块
  # 无条件指向 `alertmanager:9093`。结果是：默认部署下 Prometheus 持续重试
  # 一个不存在的 target，告警既不外发、也不出现在 Alertmanager 侧
  # （Prometheus 只在自己 UI 显示 firing）。这是"以为接了告警、实际没接"。
  #
  # 保持默认起、但 receiver 仍是 `empty`（不误报到真实渠道）——即
  # **链路默认可达、投递默认关闭**：运维能在 Alertmanager UI 看到告警分组、
  # 做 silence（静默）与 ack（确认），把 `empty` 从"丢弃黑洞"升格为
  # "可操作的观察窗"。
  #
  # 用法：docker compose up -d alertmanager（现已属默认服务，无需 --profile）
  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: ipproxy-alertmanager
    restart: unless-stopped
    ports:
      - "127.0.0.1:9093:9093"
    volumes:
      # 收件人配置由 **alertmanager 自己**读这个路径（Prometheus 不读它）。
      - ./deploy/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager-data:/alertmanager
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"

volumes:
  redis-data:
  clickhouse-data:
  grafana-data:
  alertmanager-data:
  # 步骤 52：控制面托管节点持久化（/app/data/nodes.json）。
  gateway-data:
  # OPT-R7 C2：Prometheus TSDB 持久化（此前缺失 ⇒ 每次 recreate 指标归零）。
  prometheus-data:
</file>

<file path=".github/workflows/ci.yml">
# IPProxyPool CI (Phase C5): mirrors the local four-gate exactly.
# Local: cargo fmt --check / cargo clippy --workspace --all-targets -- -D warnings
#        / cargo test --workspace / cargo bench --workspace --no-run
#        (+ cargo test --release bandit for the <200ns select path).
# Live `-- --ignored` tests need Redis + ClickHouse, so they live in
# live.yml (manual dispatch only), never in this auto gate.
name: ci

on:
  push:
    branches: ["**"]
    # OPT-R9 A4：纯文档改动不触发 Rust 全量冷编译。
    # 依赖树含 pingora/ring/openssl-sys/lz4/zstd/aws-lc-rs 等重型原生 crate，
    # 此前改一行 .md 也会触发整树重编（无 paths-ignore ＋ 无缓存）。
    # 注意：docs/ 下的文档含**可执行的命令与代码片段**，改动它们可能需要
    # 跑 static-checks（如 README 里的 compose 命令），故**只忽略**根级
    # 与 plan/ 下的纯记录性文档，不忽略 docs/。
    paths-ignore:
      - "**/*.md"
      - "!docs/**"
      - "plan/**"
      - "log/**"
  pull_request:

jobs:
  gates:
    # Runner 显式 pin ubuntu-26.04：ubuntu-latest 将于 2026-10-19 起迁 Ubuntu 26
    # （actions/runner-images#14748）。提前一天主动切换，借本轮全绿 CI 验证 26 镜像
    # 上的四门；标签跟随该 series 最新 patch 镜像（ubuntu26/20261012.163 已可用）。
    runs-on: ubuntu-26.04
    defaults:
      run:
        working-directory: gateway
    steps:
      # Node20 弃用注记清零（2026-10-18）：checkout v4→v7、setup-java v4→v6、
      # setup-dotnet v4→v6；inputs（temurin+21 / 8.0.x）跨 major 兼容，本轮 CI 全绿实证。
      - uses: actions/checkout@v7
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      # OPT-R9 A4：缓存 cargo 依赖与构建产物。
      # 无缓存时每次 push 都要重编整个依赖树（数分钟）；`Swatinem/rust-cache`
      # 按 Cargo.lock 的哈希做 key，lockfile 不变即命中。
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: gateway
          # 缓存 target/ 与 ~/.cargo/registry；lockfile 变则 key 变，自动失效。
          shared-key: ipp-gateway
      # OPT-R9 A4：全部 cargo 命令加 `--locked`。
      # 缺此 flag 时，CI 会**静默重写** Cargo.lock（解析出新版本），
      # 与 docs/OPEN-SOURCE.md「锁 Cargo.lock 构建可复现」的承诺相悖。
      # 加 `--locked` 后，manifest 与 lockfile 不一致会**直接失败**。
      - name: fmt
        run: cargo fmt --check
      - name: clippy
        run: cargo clippy --locked --workspace --all-targets -- -D warnings
      - name: unit tests
        run: cargo test --locked --workspace
      # OPT-R9 C1 / OPT-R10 B1 / OPT-R11 B1：分配契约门（**必须串行 + --include-ignored + --exact**）。
      #
      # 三个测试锁定「生产热路径零分配」的性能契约：
      #   * `router::tests::opt_r9_c1_isolated_lookup_does_not_allocate` —— 隔离查表；
      #   * `gateway::tests::opt_r10_b1_arm_for_hit_path_does_not_allocate` —— LinUCB
      #     臂表命中路径（`arm_for`，每请求每候选一次）；
      #   * `router::tests::opt_r11_b1_pick_weighted_streaming_hit_path_does_not_allocate`
      #     —— 流式加权选路（替代了每请求 O(N) 物化）。
      #
      # 三个参数**缺一不可**，每个都实测踩过：
      #   * `--test-threads=1`：`#[global_allocator]` 的计数器是**进程级**的，
      #     并行测试的分配会污染读数（实测并行下假红）。
      #   * `--include-ignored`：三个测试都带 `#[ignore]`（让并行全量 `cargo test`
      #     保持全绿）。只给过滤器不给它，libtest 会跳过并报 `0 passed`
      #     —— 门禁静默失效。**OPT-R11 实测再次踩中**：新增的第三个测试在加入
      #     串行循环前一直是 `ignored`、从未真正跑过，首次实跑就暴露了测试
      #     自身的缺陷（循环内 `thread_rng()` 首次 TLS 初始化被计入窗口）。
      #   * `--exact` + **完整测试名**（含模块路径）：只写函数名会过滤不命中，
      #     同样静默跑不到任何测试（实测 `--exact` 配短名报 0 passed）。
      #
      # 为何**不**改成「并行下不误报」：实测那种设计会让真实回归溜过——把
      # `format!`/`clone`/物化塞回热路径后分别观察到 2000/1000/65000 次分配，
      # 却被当作「污染」放行。**放宽判据的门禁等于没有门禁。**
      - name: allocation-contract tests (serial + include-ignored)
        run: |
          set -euo pipefail
          for t in \
            router::tests::opt_r9_c1_isolated_lookup_does_not_allocate \
            gateway::tests::opt_r10_b1_arm_for_hit_path_does_not_allocate \
            router::tests::opt_r11_b1_pick_weighted_streaming_hit_path_does_not_allocate
          do
            cargo test --locked --workspace "$t" \
              -- --test-threads=1 --include-ignored --exact 2>&1 | tee alloc-test.log
            grep -q "1 passed" alloc-test.log || {
              echo "::error::allocation-contract test did not run: $t (expected '1 passed')"
              grep -E "test result|running [0-9]+ test" alloc-test.log || true
              exit 1
            }
          done
      - name: release bandit (<200ns select path)
        run: cargo test --locked --release bandit
      - name: bench compile
        run: cargo bench --locked --workspace --no-run
      # OPT-R9 A4：lockfile 漂移断言。
      # `--locked` 保证「cargo 不改 lockfile」，但**不保证**「lockfile 与
      # manifest 本来就一致」——若有人改了 Cargo.toml 却没提交 Cargo.lock，
      # 上一步会失败（好）；但若有人**连 lockfile 一起改错**，这里兜底。
      # 缓存命中时 cargo 可能完全不碰 lockfile，故仍需显式断言工作区未被改。
      - name: Cargo.lock unchanged by the build
        run: |
          if ! git diff --exit-code -- gateway/Cargo.lock; then
            echo "::error::gateway/Cargo.lock was modified during the build (--locked should have prevented this)"
            git diff -- gateway/Cargo.lock | head -50
            exit 1
          fi
          echo "Cargo.lock unchanged"

  # OPT-R4 C8：脚本/配置漂移门（端口/头名/规则在合入前拦截；cargo 门在上）。
  static-checks:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@v7
      - name: PowerShell scripts (PSScriptAnalyzer, errors only)
        shell: pwsh
        run: |
          Install-Module PSScriptAnalyzer -Scope CurrentUser -Force
          Invoke-ScriptAnalyzer -Path tools -Recurse -Severity Error -EnableExit
      - name: Python scripts compile
        run: python3 -m compileall -q tools log/mock_upstream.py log/probe_free.py log/launch_detached.py deploy/geoip_update.py
      - name: PowerShell scripts carry UTF-8 BOM (OPT-R7 D1)
        # git 会剥离 UTF-8 BOM 且不受 .gitattributes 控制（实测记录见
        # .gitattributes 的 OPT-R7 D1 段），故只能靠 CI 断言守住工作区副本。
        # 缺 BOM 时 Windows PowerShell 5.1 会按 GBK 代码页解析中文注释 →
        # 乱码乃至解析失败（事故背景见 docs/FREE_BASELINE.md）。
        run: python3 tools/check_ps1_bom.py
      # OPT-R17: configuration files must NOT carry a UTF-8 BOM.
      #
      # This is the exact inverse of the step above, and the pairing is
      # deliberate: git strips UTF-8 BOMs (documented in .gitattributes,
      # OPT-R7 D1), so a BOM can only be reintroduced from the working tree
      # side (IDE "UTF-8 with BOM", PowerShell 5.1 Set-Content -Encoding UTF8).
      #
      # Verified failure this gate locks: gateway/Cargo.toml carried a BOM,
      # so Swatinem/rust-cache could not parse the manifest and fell back to
      # caching the WHOLE FILE -- silently losing the per-Cargo.lock-hash key
      # that the OPT-R9 A4 caching work was meant to provide. Cargo itself
      # tolerates the BOM (build/tests passed), which is exactly why this
      # degraded silently instead of failing loudly.
      #
      # Kept as a separate script rather than a branch inside check_ps1_bom.py:
      # that file's entire logic assumes "must HAVE a BOM". Mixing an
      # opposite-direction rule in would make the file unreadable.
      - name: Config files carry no UTF-8 BOM (OPT-R17)
        run: python3 tools/check_no_bom.py
      # OPT-R16 E6: static gate for shell: powershell steps (PS 5.1) whose
      # run: body must stay pure ASCII. Added because run 37117250483 step #4
      # failed with "Missing closing ')'" caused by an em dash inside the
      # step's own script, which the runner truncated mid-string. The error
      # pointed at the runner's temp .ps1, so it was not reproducible locally.
      - name: CI shell compatibility (PS 5.1 run blocks stay ASCII)
        run: python3 tools/check_ci_shell_compat.py
      # OPT-R17: observability / dependency-declaration truthfulness gate.
      #
      # Two verified failures from the OPT-R17 capability audit, both of the
      # same shape: "the config or docs say something exists that the code
      # does not implement". Neither turns any test red, which is exactly
      # why both survived CI:
      #   A. gateway/Cargo.toml declared tower-http features
      #      ["cors", "trace", "timeout"] while src/ referenced tower-http
      #      ZERO times, and admin.rs's own doc comment claimed "CORS +
      #      timeout". Result: no request timeout, no access audit trail,
      #      and a comment promising a cross-origin policy that did not exist.
      #   B. docs/OPERATION.md (27KB ops manual) never mentioned
      #      "alertmanager" at all, so an operator reading it could not tell
      #      that the 15 alert rules do NOT page anyone (receiver: "empty").
      #
      # Bidirectionally verified at authoring time. One trap worth recording:
      # the gate greps source with COMMENTS STRIPPED. Without that, the gate is
      # satisfied by its own rationale prose -- it reported green on an
      # injected regression because the explanatory comment happened to
      # contain the literal token "CorsLayer".
      - name: Observability + dependency truthfulness (OPT-R17)
        run: python3 tools/check_observability_truth.py
      - name: No plaintext credentials in process argv (OPT-R8 A5)
        # 凭据进 argv 会被同机任意用户读到（Get-CimInstance Win32_Process /
        # /proc/<pid>/cmdline）。正确做法是环境变量（REDISCLI_AUTH /
        # CLICKHOUSE_PASSWORD）或请求头（X-ClickHouse-Key）。
        run: python3 tools/check_no_plaintext_creds.py
      # OPT-R10 A1：第三方**数据**署名门。
      #
      # 这是**唯一有法律时效**的检查（CC BY-SA 4.0 §3(a) 强制署名）。此前
      # docs/OPEN-SOURCE.md 两处声称「OPERATION 有署名行」，而 OPERATION 里
      # 实际只有 GeoLite2 的操作步骤、**没有任何署名**——对外的不实陈述 ＋
      # 合规缺口。本门断言四要素齐全（提供者/许可名称/许可链接/免责声明/来源），
      # 防止署名在后续文档精简中被改坏。
      #
      # 为何不靠 review：署名是纯文档改动，最容易被"顺手精简"掉，而它一旦
      # 丢了就是**分发即违规**。
      - name: Third-party data attribution (MaxMind / CC BY-SA 4.0)
        run: python3 tools/check_attribution.py
      # OPT-R10 D1：活文档的测试数字必须与权威基线一致。
      #
      # 实测漂移：`docs/FEATURES.md` 停在 209（落后 5 轮）、`README.md` 停在
      # 201→235（且 live 数写成 5、实为 4）。数字散落 10+ 文件、手改必漂。
      #
      # 关键设计：门禁**只扫活文档**（ALLOWLIST），**不扫历史文件**
      # （CHANGELOG/TASK_PLAN/plan/EXEC_LOG）——那些记录的是某轮收官的真实
      # 状态（OPT-R4 收官确为 201），改了就等于伪造执行记录。
      - name: Doc quality numbers match canonical baseline
        run: python3 tools/check_doc_consistency.py
      # OPT-R16 D：Cargo.toml 的 version 必须在 CHANGELOG.md 里有对应小节。
      # 版本号 bump 而不同步 changelog，几个月后没人知道新版本里装了什么。
      # 只判"有没有小节"，不判内容详实程度（那是 review 的事）。
      - name: Changelog matches Cargo.toml version
        run: python3 tools/check_changelog.py
      # OPT-R12 A2：鉴权配置文档必须说清 `REQUIRE_API_KEY=0` / `API_KEY` 的真实语义。
      #
      # 实测确认的失实：此前只写「`REQUIRE_API_KEY=0` 显式关闭鉴权门」，而
      # release 二进制实测该配置下**完全不带 key 的请求返回 200** 并拿到完整
      # 代理服务（无头被静默补成 qps=10000 的默认租户）。真实语义是「全网共享
      # 一个满额身份」，与「关闭鉴权」差了一个量级。
      #
      # 不准确文档比没有文档更糟——它给运维虚假的安全感。与 MaxMind 署名门
      # 同属「对外表述 vs 实际行为」类，故同样用静态门锁住。
      - name: Auth config docs state the real semantics
        run: python3 tools/check_auth_docs.py
      # 步骤 52：Admin 路由 ↔ 文档双向门（静态、无网络）。
      #
      # 实测风险：新增 POST/DELETE /nodes 时，`admin.rs` 与 `ADMIN_API.md`
      # 必须同步；只改一边 CI 仍全绿——文档写了但没注册（调用 404），或
      # 注册了但没写（客户端不知道）。本门只比对 `### METHOD \`/api/v1/...\``
      # 标题与 `build_router_with` 的 `.route(...)`，**不做全文 grep**（否则
      # 说明/示例里的路径会让门假绿，OPT-R17 教训）。变异自测：注入未文档化
      # 路由 → 红；文档写 ghost 端点 → 红；路由只出现在注释 → 绿。
      - name: Admin routes match documented endpoints (bidirectional)
        run: python3 tools/check_admin_routes_documented.py
      # OPT-R18 P1-5：选路回放台的三道离线门（全部纯标准库，不需要 CH/Redis）。
      #
      # 为什么这三道必须一起进 CI：
      #   * `routing_replay.py --self-test` —— 锁**工具自身**的不变量（确定性、
      #     oracle>轮询、LinUCB>轮询）。它若坏了，后面两份报告全部失去意义。
      #   * `check_replay_parity.py` —— 锁 Python 镜像 vs Rust 生产实现的公式
      #     一致性。黄金向量由生产实现自己生成（不是手写期望值），否则同一个
      #     理解错误会同时通过两份断言。
      #   * `check_routing_baseline.py` —— 锁**文档发布的数字**。实测确认：
      #     把 `docs/ROUTING_BASELINE.md` 的 linucb 成功率从 52.2% 改成 52.3%，
      #     改样本条数、改 seed、删掉 oracle 行，四种漂移全部判红。
      #
      # 三者缺任何一道都会留一个"静默失真"窗口：工具坏了没人知道 / 镜像漂了
      # 报告算的是另一个策略 / 文档过期但仍在对外声称收益。
      - name: Routing replay invariants (determinism, oracle>RR, LinUCB>RR)
        run: python3 tools/routing_replay.py --self-test
      - name: Replay parity (Python mirror vs Rust golden vectors)
        run: python3 tools/check_replay_parity.py --self-test
      - name: Published routing baseline matches replay output
        run: python3 tools/check_routing_baseline.py --self-test
      # OPT-R18 P1-4：模块 ↔ docs/COMPONENTS.md 双向结构门。
      #
      # 落门时实测到四类失真**同时存在**（此前 CI 全绿）：
      #   A. 文档声称「模块表（19 个）」，实际 24 个 `.rs`——漏掉的 5 个里
      #      `admin.rs` 是 1788 行的 Admin REST 面，读者按文档建心智模型会
      #      完全不知道它存在；
      #   B. 同一份文件里 `vendor_arbitrage.rs` 中文行写 208 行、英文行写 218
      #      行（描述同一个文件，必有一行是假的）；
      #   C. `socks_handshake.rs` 那行的「关键 API」写作 `socks_handshake`，
      #      而该字符串在文件里一次都没出现（真实 API 是 `establish`）；
      #   D. 单测总数停在 156，而基线是 338——它此前不在任何门禁范围内。
      #
      # 断言全部**结构化**（解析表格后比对单元格），不做全文 grep：OPT-R17
      # 实测过说明性注释恰好含目标 token 时门会对自己注入的回归报绿。
      # 变异自测：漏登记模块 / 篡改单测数 / 编造 API 三处注入必须全部判红。
      - name: Components doc matches source modules (bidirectional)
        run: python3 tools/check_components_docs.py --self-test
      # OPT-R14 A2：free 池**契约**门（确定性，不依赖公网）。
      #
      # 刻意**不做**"healthy 节点数 ≥ N"的数量门：公网免费代理存活率天然 churn
      # （2026-09-30 实测两轮分别 30 / 22 个通过验证），任何数量门都会周期性假红，
      # 而假红门禁会被运维学会忽略——比没有门更糟。数量的可重复验证改由报告式
      # `tools/probe_free_pool.py` 承担（需公网 + 数分钟，不进 CI）。
      #
      # 本门只锁确定性的四类：verify 分类集合 / 指标名 / intake 下限 / 文档口径。
      # 已实证它能抓：新增未登记分类、去掉 intake 下限、抹掉文档"未验证"口径。
      - name: Free-pool supply-side contract (deterministic, no internet)
        run: python3 tools/check_free_pool_contract.py
      # OPT-R14 B4：Windows「300 秒自杀」的修复不得被静默回退。
      #
      # 根因在依赖：`pingora-core 0.6.0` 的 `Server::run()` 有
      # `#[cfg(windows)] let shutdown_type = ShutdownType::Graceful;` —— Windows 上
      # `main_loop` 从不被 await（那段是 `#[cfg(unix)]`），**没有信号等待**，
      # 于是必然 `sleep(grace_period)` 后 `process::exit(0)`。本机实测退出寿命
      # **305~308s**，且**无 panic、无错误码**，此前被误判为随机崩溃。
      #
      # 修复是「`GATEWAY_GRACE_SECS` 默认值平台感知」。这类修复的典型死法是：
      # 有人看到「Windows 默认 86400 看着奇怪」就清理回 300 —— **Unix 侧行为
      # 一模一样、全绿**，而 Windows 上网关又开始 5 分钟自杀。
      - name: Windows lifetime fix must not be reverted (OPT-R14)
        run: python3 tools/check_windows_lifetime.py
      # ---- OPT-R9 A3：SDK 编译验证 ----
      # 4 个非 Python SDK 此前从未被任何构建系统碰过（仓库无 go.mod/.csproj/
      # package.json，CI 只跑 python3 compileall）。审阅已发现两处**确定破损**：
      #   ① ipp_sdk_go.go 文件头写 `import ipp "path/to/..."`，而它是
      #      `package main` —— Go 禁止 import package main，示例 100% 编译失败；
      #   ② ipp_sdk_dotnet.cs 文件头写 `dotnet run -- --self-test`，无 .csproj
      #      时该命令直接报错。
      # 两处文档已在 OPT-R9 A3 修正；下面是**代码级**门禁，防同类问题复发。
      #
      # 能力边界（如实标注）：Node 只做**语法**检查（JS 没有零配置的类型检查
      # 方案）；Go/Java/.NET 做**完整编译**（含类型检查）。运行时验证靠各 SDK
      # 自带的 --self-test（需网关在线，不进快速门）。
      - name: Go SDK compiles (go vet + go build)
        run: python3 tools/check_go_sdk.py
      - name: Node SDK syntax check
        run: python3 tools/check_node_sdk.py
      - name: .NET + Java SDK compile
        # 显式固定 SDK 版本：runner 预装版本会漂移，而 SDK 代码可能用到新语法。
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "21"
      - name: .NET + Java SDK compile (run)
        run: |
          python3 tools/check_jvm_sdk.py --java
      - name: .NET SDK compile (run)
        uses: actions/setup-dotnet@v6
        with:
          dotnet-version: "8.0.x"
      - name: .NET SDK compile (run2)
        run: python3 tools/check_jvm_sdk.py --dotnet
      # OPT-R10 C2：SDK 错误契约静态门（**不依赖任何编译器**）。
      #
      # 为何编译门不够：.NET/Java 的编译门依赖 SDK 预装，**本机没有 .NET SDK**
      # （NuGet provider 缺失装不上），意味着 .NET 改动在本机**完全没有验证**。
      # 历史上 .NET 正是 5 个语言里唯一"改了没人编译"的那个，其
      # `GetAsync` 函数内自相矛盾的错误通道（解析失败 return / scheme 抛异常）
      # 就是这么长期存活的。本门纯文本断言，无论 CI 有无 SDK 都能拦回归。
      - name: SDK error-contract consistency (5 languages, compiler-free)
        run: python3 tools/check_sdk_contract.py
      # OPT-R7 B2：规则/配置解析显式指定 UTF-8。仓库的 YAML/JSON 均含中文注释，
      # 而 Python 的 `open()` 默认跟随**系统 locale 编码**——在非 UTF-8 locale
      # （如 Windows 上的 GBK）会抛 UnicodeDecodeError。本机实测即如此：
      # 未加 `encoding="utf-8"` 时三条检查全挂在解码上。
      # 加 `encoding="utf-8"` 后与 locale 无关，跨平台稳定。
      - name: Prometheus rules (YAML syntax)
        run: python3 -c "import yaml; d=yaml.safe_load(open('deploy/prometheus/rules.yml', encoding='utf-8')); assert d['groups'], 'no rule groups'"
      # OPT-R9 A1：promtool 做 **PromQL 静态类型检查**——yaml.safe_load 只验缩进语法，
      # 验不出 `histogram_quantile(0.99, "str")` 这类参数类型错。
      # 用 Prometheus 官方镜像（版本与 docker-compose.yml 的 prom/prometheus 一致，
      # 避免版本漂移造成误报/漏报）。`--entrypoint promtool` 覆盖镜像默认 ENTRYPOINT。
      # 名称里的冒号必须加引号——YAML 会把未加引号的 `key: value` 里的冒号
      # 当作映射分隔符（实测踩过：整份 workflow 因此解析失败）。
      - name: "Prometheus rules (promtool: PromQL types, not just YAML)"
        run: |
          docker run --rm --entrypoint promtool \
            -v "$PWD/deploy/prometheus:/rules:ro" \
            prom/prometheus:v2.53.0 check rules /rules/rules.yml
      # OPT-R9 A2：指标名 + **聚合标签**与 metrics.rs 的实际渲染对账。
      # 为何需要这道（promtool 抓不到的）：实测把「分母写成 sum by(provider) 而该指标
      # 只有 status 标签」注入后，promtool 报 SUCCESS 放行——但该表达式运行期恒返回
      # 空集。promtool 只做静态类型检查，不做运行期标签匹配。
      - name: PromQL metrics/labels match metrics.rs (OPT-R9 A2)
        run: python3 tools/check_promql_metrics.py
      - name: Alertmanager config syntax
        run: python3 -c "import yaml; yaml.safe_load(open('deploy/alertmanager.yml', encoding='utf-8'))"
      - name: Dashboards + compose valid
        run: |
          python3 -c "import json,glob; [json.load(open(p, encoding='utf-8')) for p in glob.glob('deploy/grafana/**/*.json', recursive=True)]"
          docker compose config --quiet
      - name: Gateway D3 defaults (127.0.0.1:8916 + REQUIRE_API_KEY=1)
        # D3 缺省双断言：监听缺省收回环＋API Key 门缺省开启（PORT-8916/D3；
        # 正向断言，比全仓扫 8080 稳：18080/888x/历史注记天然豁免）。
        run: |
          grep -q "127.0.0.1:8916" gateway/src/main.rs
          grep -q '!= Ok("0")' gateway/src/main.rs
          grep -q "127.0.0.1:8916" tools/ipp.ps1
          grep -q "127.0.0.1:8916" tools/ipp_sdk.py
      # OPT-R5 O8：C6 转 CI 云端验镜像（本地 Hub 不通零验证；ubuntu runner 有 docker）。
      - name: Gateway image build
        run: docker build -t ipproxy-gateway:ci ./gateway
      - name: Compose dual-profile config (gateway + observability)
        run: docker compose --profile gateway --profile observability config --quiet

  # OPT-R9 B1：Windows PowerShell 5.1 门（覆盖**生产真实执行环境**）。
  #
  # 为何必须单独一个 job（此前是结构性漏洞）：
  #   现有 static-checks 用 `shell: pwsh` on **ubuntu-latest** = Linux 上的
  #   PowerShell 7。而 tools/ 下 6 个 .ps1 全部是 **Windows PowerShell 5.1**
  #   专属（`#Requires -Version 5.1`；`install_watchdog.ps1` 用 `schtasks`；
  #   `ipp.ps1` 用 `Get-CimInstance Win32_Process`；`docs/USAGE.md` 改
  #   `HKCU:\` 注册表）。PS 7 on Linux 的**解析器与 cmdlet 集都不同**，
  #   验不到生产面——仓库已因「.ps1 缺 BOM 致 PS 5.1 误解析」踩过一次坑
  #   （见 docs/FREE_BASELINE.md）。
  #
  # 本 job 的两道检查都**不执行脚本**（只解析），因此不需要 Docker/网关/凭据：
  #   ① PSScriptAnalyzer：静态规则；
  #   ② [PSParser]::Tokenize：解析器级别的语法/编码校验。
  windows-powershell:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v7
      # `shell: powershell` 就是 **Windows PowerShell 5.1**（不是 pwsh）——
      # 这正是本 job 的意义所在。
      - name: PSScriptAnalyzer (Windows PowerShell 5.1)
        shell: powershell
        # OPT-R16 E6: keep the `run:` body pure ASCII.
        # `shell: powershell` is Windows PowerShell 5.1, which receives this
        # block as a generated .ps1 file encoded from the runner's code page.
        # Any non-ASCII byte (CJK comments, em dash U+2014, etc.) can be
        # truncated mid-string, which cascades into bogus parser errors such
        # as "Missing closing ')'" / "string is missing the terminator".
        # Evidence: run 37117250483 step #4 failed with exactly those errors
        # while the script itself was valid. All rationale prose therefore
        # lives HERE (YAML comments, never parsed by PowerShell), not inside
        # the run block.
        #
        # Rationale for a version pin: PSGallery packages can be re-published
        # by their authors, so a floating version makes the same source yield
        # different verdicts over time. Pinned to an exact version.
        #
        # Rationale for a whitelist (-IncludeRule) rather than a blacklist
        # (-ExcludeRule):
        #   * The rule set stays FIXED and is immune to new rules appearing in
        #     newer PSScriptAnalyzer releases. Under a blacklist, an upgrade
        #     can turn existing code red for reasons unrelated to any real
        #     defect being introduced.
        #   * It cannot fail on first run merely because the count of
        #     pre-existing warnings is unknown (we cannot install PSSA locally,
        #     so we cannot enumerate them beforehand).
        #   * Clearer semantics: we are only accountable for the rules we
        #     explicitly opted into.
        #
        # Whitelist criterion: rules that can cause REAL failures (uninitialized
        # variable, alias shadowing a built-in cmdlet, ambiguous positional
        # parameters, hardcoded credentials) rather than style rules.
        run: |
          Install-Module PSScriptAnalyzer -RequiredVersion 1.21.0 `
            -Scope CurrentUser -Force -ErrorAction Stop
          Import-Module PSScriptAnalyzer -RequiredVersion 1.21.0
          $results = Invoke-ScriptAnalyzer -Path tools -Recurse -IncludeRule @(
            'PSUseDeclaredVarsMoreThanAssignments',
            'PSAvoidUsingCmdletAliases',
            'PSAvoidUsingPositionalParameters',
            'PSAvoidUsingPlainTextForPassword',
            'PSReviewUnusedParameter'
          )
          if ($results) {
            $results | Format-Table RuleName, Severity, ScriptName, Line, Message -AutoSize |
              Out-String -Width 220 | Write-Output
            Write-Error "PSScriptAnalyzer found $($results.Count) issue(s) in the whitelisted rule set"
            exit 1
          }
          Write-Output "PSScriptAnalyzer (whitelisted rules): clean"
      - name: PowerShell 5.1 parse check (encoding + syntax)
        shell: powershell
        # OPT-R16 E6: keep the `run:` body pure ASCII (same reason as the
        # PSScriptAnalyzer step above).
        #
        # What this checks, per file under tools/:
        #   1. Parse errors (unbalanced brackets/quotes/structure) via
        #      PSParser::Tokenize.
        #   2. Missing UTF-8 BOM. Windows PowerShell 5.1 reads a BOM-less
        #      .ps1 as ANSI/code page, which garbles CJK comments and can
        #      cause real parse failures. This repo has hit it before; see
        #      docs/FREE_BASELINE.md.
        # Parse only, never execute: no Docker, no gateway, no credentials.
        # This is a purely static gate.
        #
        # Corrected diagnosis (OPT-R16 E6 supersedes E5):
        # E5 blamed `Get-Content -Raw` for reading with the ANSI code page
        # and added `-Encoding UTF8`. That was WRONG: the failure was not in
        # the file being read, it was in THIS step's own generated .ps1.
        # The runner emitted the run block as a .ps1 in PS 5.1; the em dash
        # (U+2014) inside the Write-Error string below was truncated
        # mid-string, so the string never closed and every following line got
        # swallowed into it -- surfacing as "Missing closing ')'" and
        # "The string is missing the terminator", all pointing at
        # D:\a\_temp\<uuid>.ps1 rather than at any repo file.
        # `-Encoding UTF8` is kept because it is correct and explicit, but
        # the actual fix is ASCII-only run bodies.
        run: |
          $failed = $false
          $files = Get-ChildItem -Path tools -Filter *.ps1 -Recurse
          foreach ($f in $files) {
            $bytes = [System.IO.File]::ReadAllBytes($f.FullName)
            $hasBom = ($bytes.Length -ge 3 -and
                       $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF)
            if (-not $hasBom) {
              Write-Error "MISSING UTF-8 BOM: $($f.Name) -- PS 5.1 reads BOM-less .ps1 as ANSI"
              $failed = $true
            }
            $errors = $null
            [System.Management.Automation.PSParser]::Tokenize(
              (Get-Content -LiteralPath $f.FullName -Raw -Encoding UTF8), [ref]$errors) | Out-Null
            if ($errors -and $errors.Count -gt 0) {
              foreach ($e in $errors) {
                Write-Error "PARSE ERROR $($f.Name): line $($e.Token.StartLine) -- $($e.Message)"
              }
              $failed = $true
            }
          }
          if ($failed) { exit 1 }
          Write-Output "PowerShell 5.1 parse + BOM: clean ($($files.Count) file(s))"

  # OPT-R18 P2-5：覆盖率基线门。
  #
  # 为何单独一个 job（而不塞进 static-checks）：static-checks 是**纯 Python**
  # 门（不装 Rust 工具链），而本门要真跑 `cargo llvm-cov`——它需要
  # `llvm-tools-preview` 组件 + `cargo-llvm-cov` 二进制，且要为覆盖率
  # 重新编译一遍（instrumentation build，与普通 build 是两套产物）。
  # 塞进 static-checks 会让那个 job 多出数分钟的 Rust 编译。
  #
  # 为何单独一个 job（而不塞进 gates）：gates 是**快速反馈**门（fmt/clippy/
  # test），覆盖率要重编全树、慢一到两个数量级；且 gates 已有的 cargo 缓存
  # 与覆盖率构建**不共享产物**（instrumentation 标志不同），合在一起只会
  # 让 gates 的缓存命中率下降。
  #
  # **平台可比性**：本仓基线是在 Windows/MSVC（x86_64-pc-windows-msvc）
  # 上测的，而 CI 跑 Ubuntu。两者 codegen 与 `cfg(unix)/cfg(windows)` 分支
  # 不同，覆盖率**数值不可比**。故门禁按工具链+平台判定可比性：不可比时
  # **只**校验文件集一致（[A]）与文档↔JSON 一致（[C]），**显式打印**跳过
  # 数值判定的原因——绝不静默放行。
  #
  # 数值回退判定（[B]）的实际执行处在本地开发机（与基线同平台同工具链），
  # 见 docs/COVERAGE_BASELINE.md §5。
  coverage:
    runs-on: ubuntu-26.04
    defaults:
      run:
        working-directory: gateway
    steps:
      - uses: actions/checkout@v7
      - uses: dtolnay/rust-toolchain@stable
        with:
          # llvm-tools-preview 提供 llvm-profdata/llvm-cov；缺它时
          # `cargo llvm-cov` 会在收尾阶段报错"llvm-profdata not found"。
          components: llvm-tools-preview
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: gateway
          shared-key: ipp-gateway-coverage
      - name: Install cargo-llvm-cov
        # 锁版本：`cargo-llvm-cov` 的 JSON 输出结构在不同版本间有过变化
        # （早期直接是 dict，现在是 {"data": [ ... ]} 列表）。不锁版本时，
        # 上游一次升级就能让门禁读不到字段而崩——门禁崩掉 ≠ 门禁守住。
        run: cargo install --locked cargo-llvm-cov --version 0.9.1
      - name: Measure coverage
        # `--summary-only` 只出汇总；`--json` 出机器可读报告。
        # `--locked` 与全仓一致：不许 CI 静默改写 Cargo.lock。
        run: cargo llvm-cov --locked --summary-only --json --output-path coverage.json
      - name: Coverage baseline gate
        # 从仓库根目录跑：门禁脚本按仓库根解析 `docs/` 与 `tools/` 路径，
        # 而 coverage.json 在 `gateway/` 下（job 默认 working-directory 是
        # gateway）。故此处显式改回根目录，路径也相应写成 `gateway/...`。
        working-directory: .
        run: python3 tools/check_coverage_baseline.py --json gateway/coverage.json
      - name: Coverage gate self-test (mutation)
        # 证明门禁**有判别力**：四处注入（覆盖率回退 / 基线文件缺失 /
        # markdown-JSON 不一致 / 不可比模式只跳过数值判定）必须全部判红。
        # 一个从不判红的门禁比没有门更危险——它会给人虚假的安全感。
        working-directory: .
        run: python3 tools/check_coverage_baseline.py --self-test

  # OPT-R16 C: supply-chain gates (vulnerabilities + bans + licenses + sources).
  #
  # Runs cargo-deny (advisories/bans/licenses/sources per gateway/deny.toml)
  # and cargo-audit (independent vuln scan) via tools/check_supply_chain.py.
  # Follows the repo convention: CI installs the toolchain, the Python gate
  # shells out to it, missing toolchain = skip locally / hard fail here.
  #
  # Cost note: first run compiles both tools from source (~10 min) and fetches
  # the RustSec DB (~1 min); rust-cache makes subsequent runs fast (lockfile
  # hash key). This job runs in parallel with gates/static-checks, so it does
  # not lengthen the critical path after warmup.
  supply-chain:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@v7
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: gateway
      - name: Install cargo-deny + cargo-audit
        run: cargo install --locked cargo-deny cargo-audit
      - name: Supply-chain gates
        run: python3 tools/check_supply_chain.py

  # OPT-R18 P1-2：前端此前是**唯一不在门禁内的交付物**（1888 行 / 7 页，
  # 无 test 脚本、CI 无 npm 步骤），后端契约一变前端可能静默崩而 CI 全绿。
  #
  # 本 job 只做「能编译 + 能构建」：`tsc --noEmit` 抓类型断链，`vite build`
  # 抓入口/依赖/资源解析。**不引入 Playwright**——浏览器下载在受限网络下
  # 不可靠，且它挡的失败类型（渲染回归）与本 job 挡的类型（编译回归）不重叠，
  # 先把零成本的那一层补上。
  web:
    runs-on: ubuntu-26.04
    defaults:
      run:
        working-directory: web/admin
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v4
        with:
          # Vite 5 要求 Node >= 18；锁 22 与本仓 Rust 侧无关，仅为可复现。
          node-version: "22"
          cache: npm
          cache-dependency-path: web/admin/package-lock.json
      # `npm ci` 要求 lockfile 与 package.json 严格一致：依赖被手改而未
      # 更新 lockfile 时直接失败（对应 Rust 侧 `--locked` 的同一意图）。
      - name: Install (lockfile-strict)
        run: npm ci
      - name: Type check
        run: npx tsc --noEmit
      - name: Build
        run: npm run build

  # OPT-R18 P1-3：Windows 是主开发平台（README 快速开始即 PowerShell），
  # 但此前 windows job 只验 PowerShell 脚本、**不跑任何 Rust 测试**。
  # `default_grace_secs(cfg!(windows))` 正是 OPT-R14「300 秒自杀」P0 的修复点，
  # 而它此前只被静态门（断言"修复没被回退"）覆盖，不验证行为。
  #
  # 跑全量而非子集：Windows 上真正危险的是「Linux 能过、Windows 不能过」的
  # 平台分支（路径/rename/fsync/信号/时钟粒度），子集很容易恰好漏掉它们。
  # 冷启动约 6~8 分钟，rust-cache 后与 Linux gates 同量级。
  windows-rust:
    runs-on: windows-latest
    defaults:
      run:
        working-directory: gateway
    steps:
      - uses: actions/checkout@v7
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: gateway
          shared-key: ipp-gateway-windows
      - name: Unit tests (Windows)
        run: cargo test --locked --workspace
</file>

