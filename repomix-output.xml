#[test]
fn tenant_namespace_is_idempotent_and_tenant_scoped() {
    // R2-2：同名会话跨租户不串；已命名幂等；无会话/无租户不动。
    let mut spec = RoutingSpec {
        session_id: Some("task-1".to_string()),
        ..Default::default()
    };
    apply_tenant_namespace(&mut spec, Some("t-1"));
