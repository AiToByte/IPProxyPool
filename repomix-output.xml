        Self { name, url, etag: parking_lot::Mutex::new(None) }
    }

    pub fn parse(source: &str, body: &str) -> Vec<RawNode> {
        // v1 parse 逻辑逐字沿用（行切分＋socks 嗅探＋port>0＋4 段检查）。
    }
