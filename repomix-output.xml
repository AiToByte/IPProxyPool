    let r = m.render();
    // 桶行为：3ms 落 le>=5 首桶；1200ms 落 le>=2500；累计语义。
    assert!(r.contains("free_pool_fwd_latency_ms_bucket{le=\"5\"} 1"));
    assert!(r.contains("free_pool_fwd_latency_ms_bucket{le=\"+Inf\"} 2"));
