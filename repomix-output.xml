pub use crate::tenant::DEFAULT_API_KEY;

// ---------------------------------------------------------------------------
// 子模块划分（OPT-R18 P2-1 第三批）
// ---------------------------------------------------------------------------
// 本文件曾 2275 行，把**四类职责**混在一起：鉴权/分档的纯判定、LinUCB 选路
// 上下文、上游 peer 装配、SOCKS 桥转发，外加 40 个单测。改任一处都要在
// 2200 行里定位上下文。现按职责拆分（全部**逐字搬迁**，行为零变更）：
