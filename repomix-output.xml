async fn api_source_etag_not_modified() {
    // R3-5：ApiSource 礼貌轮询（对齐 GitHub）：首轮存 ETag，次轮 304→not_modified。
    let body =
        r#"{"data":[{"ip":"203.0.113.7","port":"8080","protocols":["http"],"country":"US"}]}"#;
    let (port, seen) = spawn_etag_stub(body).await;
