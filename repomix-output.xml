<# IPProxyPool free-path baseline test (one-command regression).
   Runs D/V baselines, waits for pool, fires tier request, verdict vs D/V, CH check.
   All curl calls force --noproxy '*' (shell proxy env must never hijack local checks).
   Usage: powershell -ExecutionPolicy Bypass -File tools/ipp_free_test.ps1 [-Target http://httpbin.org/ip] [-Clash http://127.0.0.1:7890] [-PoolWaitSecs 300]
#>
param(
    [string]$Target = "http://httpbin.org/ip",
    [string]$Clash = "http://127.0.0.1:7890",
    [int]$PoolWaitSecs = 300
)

$ErrorActionPreference = "Continue"
function Fail($msg) { Write-Output "FAIL: $msg"; exit 1 }

# 1. D/V baselines
$D = curl.exe --noproxy '*' --max-time 15 -s $Target
if (-not $D) { Fail "direct baseline unreachable" }
Write-Output "D-direct: $D"
$V = curl.exe --max-time 15 -s -x $Clash $Target
if (-not $V) { Write-Output "WARN: clash unreachable, V unknown"; $V = "UNKNOWN" }
Write-Output "V-vpn: $V"

# 2. wait for pool (gauge + proto)
$deadline = (Get-Date).AddSeconds($PoolWaitSecs)
$proto = ""
while ((Get-Date) -lt $deadline) {
    # curl 多行输出是数组，-match 会变过滤器且不填 $Matches，必须先拼成单串。
    $m = (curl.exe --noproxy '*' --max-time 5 -s http://127.0.0.1:9091/metrics) -join "`n"
    if ($m -match 'free_pool_nodes_total (\d+)') {
        $n = [int]$Matches[1]
        if ($n -ge 1) {
            if ($m -match 'by_proto\{proto="http"\} ([1-9])') { $proto = "http" }
            elseif ($m -match 'by_proto\{proto="socks5"\} ([1-9])') { $proto = "socks5" }
            Write-Output "pool ready: total=$n proto=$proto"
            break
        }
    }
    Start-Sleep 20
}
if (-not $proto) { Fail "pool empty after ${PoolWaitSecs}s (normal for free pool, retry later)" }

# 3. fire via gateway (forced direct; D3: key gate on, send dev key)
$headers = @("X-Api-Key: default_key", "X-Proxy-Tier: free", "Host: httpbin.org")
if ($proto -eq "socks5") { $headers += "X-Proxy-Proto: socks5" }
$hargs = @()
foreach ($h in $headers) { $hargs += "-H"; $hargs += $h }
$bodyFile = Join-Path ([System.IO.Path]::GetTempPath()) "ipp_free_body.txt"
# OPT-R8 B3：记录 HTTP 状态码——判定需要它（502/503/超时必须判 UNKNOWN，
# 不能与「响应体里没有 V/D 特征」混为一谈；旧实现两者都落到初始值 CLEAN）。
$httpCode = curl.exe --noproxy '*' --max-time 40 -s -o $bodyFile -w "%{http_code}" @hargs "http://127.0.0.1:8916/ip"
Write-Output ""
$body = Get-Content $bodyFile -Raw -ErrorAction SilentlyContinue
$bodyLen = 0
if ($body) { $bodyLen = $body.Length }
Write-Output ("body: " + $(if ($body) { $body.Substring(0, [Math]::Min(120, $bodyLen)) } else { "<empty>" }))
Write-Output ("http_code: " + $httpCode)

# 4. verdict
#
# OPT-R8 B3：**四态判定，默认失败**。
#
# 旧实现的缺陷（P1）：`$verdict` 初始值是 `"CLEAN"`，而 PowerShell 的 `-match`
# 对 `$null`/空返回 `$false` —— 于是当网关请求**失败**（502/503/超时，$body 为空）
# 时，两个 if 都不命中，判定**停留在初始值 `CLEAN`**。
# 即「一个用来证明免费出口干净的脚本，把完全失败的请求判为干净通过」——
# 失败方向与安全方向相反。
#
# 修法：① 无法取到响应体 / 非 2xx → 判 `UNKNOWN` 并**非零退出**（默认不通过）；
#      ② `CLEAN` 只能在「拿到 2xx 响应体且既不等于 V 也不等于 D」时给出。
$verdict = "UNKNOWN"
$exitCode = 1
if ([string]::IsNullOrWhiteSpace($body)) {
    $verdict = "UNKNOWN (no response body — gateway request failed or timed out; NOT a clean result)"
} elseif ($httpCode -notmatch '^2\d\d$') {
    $verdict = "UNKNOWN (http $httpCode — gateway rejected/failed; NOT a clean result)"
} else {
    $G = $body
    # 注意 V 可能是 "UNKNOWN"（Clash 不可达时），此时 Escape("UNKNOWN") 会去匹配
    # 响应体里是否含字面 "UNKNOWN" —— 语义失真，故仅在 V/D 均取到真值时比对。
    if (($V -ne "UNKNOWN") -and ($G -match [regex]::Escape($V))) {
        $verdict = "SUSPECT-VPN (G==V, re-run triple test)"
        $exitCode = 1
    } elseif (($D -ne "UNKNOWN") -and ($G -match [regex]::Escape($D))) {
        $verdict = "TRANSPARENT-or-DIRECT (G==D)"
        $exitCode = 1
    } else {
        $verdict = "CLEAN"
        $exitCode = 0
    }
}
Write-Output "verdict: $verdict (D=$D V=$V)"
Write-Output "exit_code: $exitCode"

# 5. CH corroboration (best effort, 15s pump window)
# OPT-R8 A4：凭据改读 .env／环境变量（原为硬编码 `proxy:123456`，生产密码下
# 静默失败且把开发口令写死在仓里）。与同族 ipp.ps1/backup.ps1 同源加载。
$RepoRoot = Split-Path -Parent $PSScriptRoot
$EnvFile = Join-Path $RepoRoot ".env"
if ($EnvFile -and (Test-Path -LiteralPath $EnvFile)) {
    foreach ($line in (Get-Content -LiteralPath $EnvFile)) {
        $t = $line.Trim()
        if ($t -eq "" -or $t.StartsWith("#")) { continue }
        $kv = $t -split "=", 2
        if ($kv.Count -eq 2 -and $kv[0].Trim() -ne "" -and
            ($null -eq (Get-Item -Path ("env:" + $kv[0].Trim()) -ErrorAction SilentlyContinue))) {
            Set-Item -Path ("env:" + $kv[0].Trim()) -Value $kv[1].Trim()
        }
    }
}
if (-not $env:CLICKHOUSE_USER) { $env:CLICKHOUSE_USER = "proxy" }
if (-not $env:CLICKHOUSE_PASSWORD) { $env:CLICKHOUSE_PASSWORD = "123456" }
Start-Sleep 15
# OPT-R8 A3：凭据走请求头，不进 argv（`--user u:p` 会把口令写进命令行）。
$rows = curl.exe --max-time 10 -s "http://127.0.0.1:8123/" `
    -H "X-ClickHouse-User: $env:CLICKHOUSE_USER" `
    -H "X-ClickHouse-Key: $env:CLICKHOUSE_PASSWORD" `
    --data-binary "SELECT event_time, provider, out_ip, status_code FROM proxy.proxy_telemetry_log WHERE provider LIKE 'free-%' ORDER BY event_time DESC LIMIT 2"
Write-Output "ch-free-rows:"; Write-Output $rows

exit $exitCode
</file>

<file path="tools/ipp_sdk.py">
"""IPProxyPool Python SDK（USE-便捷落地 U2，stdlib 零依赖）。

网关是反向式 egress 路由：请求打到网关地址，真实上游放 Host 头。
本 SDK 做最小封装：URL 拆分、粘滞 session、tier/proto 选择、503 延迟重试。

Usage:
    from ipp_sdk import IPPClient
    c = IPPClient("http://127.0.0.1:8916", session="job-42")
    status, body = c.get("http://httpbin.org/ip")
Self-test:
    python tools/ipp_sdk.py --self-test   # 普通200＋粘滞＋坏Key403＋无头403
D3 注记：网关默认开 API Key 门；SDK 缺省带开发 Key `default_key`
（生产传真 Key；api_key=None 即无头，用于验证 403）。
"""
import sys
import time
import urllib.request
import urllib.error
from urllib.parse import urlsplit


class IPPClient:
    def __init__(self, gateway="http://127.0.0.1:8916", api_key="default_key",
                 session=None, country=None, tier=None, proto=None,
                 timeout=10):
        parts = urlsplit(gateway)
        self.gw_host = parts.hostname or "127.0.0.1"
        self.gw_port = parts.port or 80
        self.base = f"http://{self.gw_host}:{self.gw_port}"
        self.api_key = api_key
        self.session = session
        self.country = country
        self.tier = tier
        self.proto = proto
        self.timeout = timeout

    def _headers_for(self, target_host):
        # 头名与网关 parse_routing_spec 严格同名（X-Proxy-Session/Country…；
        # 误名头会被网关静默忽略，A5 live 复验抓获过 X-Session-Id 版）。
        h = {"Host": target_host, "User-Agent": "ipp-sdk/1.0"}
        if self.api_key:
            h["X-Api-Key"] = self.api_key
        if self.session:
            h["X-Proxy-Session"] = self.session
        if self.country:
            h["X-Proxy-Country"] = self.country
        if self.tier:
            h["X-Proxy-Tier"] = self.tier
        if self.proto:
            h["X-Proxy-Proto"] = self.proto
        return h

    def get(self, url, extra_headers=None, retries=1):
        """经网关 GET 公网 URL。返回 (status, body_bytes)。503 延迟 1s 重试一次。

        错误契约（OPT-R10 C1，与 Java/Node/Go/.NET SDK 一致）——**本 SDK 是基准实现**：

        - **编程错误**（调用方把 url 用错了）⇒ 抛 ``ValueError``。当前一种：
          scheme 非 ``http``（网关不做 CONNECT 隧道，见 ``docs/SPIKE_R2.md`` 的
          E7 结论）。不重试——重试一个永远不可能成功的请求只是浪费配额。
        - **网络/网关失败**（连接失败、超时、503 重试耗尽）⇒ **不抛**，返回
          ``(0, <诊断信息>)``。可预期的瞬时故障，退避/重试策略由调用方决定；
          不要写成 catch-all 吞掉，那会丢掉可观测性。
        """
        t = urlsplit(url)
        if t.scheme != "http":
            raise ValueError("only plain http targets are supported (no CONNECT tunneling)")
        target_host = t.netloc
        path = t.path or "/"
        if t.query:
            path += "?" + t.query
        headers = self._headers_for(target_host)
        headers.update(extra_headers or {})
        last = (0, b"")
        for attempt in range(retries + 1):
            req = urllib.request.Request(self.base + path, headers=headers, method="GET")
            try:
                with urllib.request.urlopen(req, timeout=self.timeout) as r:
                    return (r.status, r.read())
            except urllib.error.HTTPError as e:
                last = (e.code, e.read())
                if e.code == 503 and attempt < retries:
                    time.sleep(1)
                    continue
                return last
            except Exception as e:
                last = (0, str(e)[:200].encode())
                if attempt < retries:
                    time.sleep(1)
                    continue
                return last
        return last


def self_test():
    gw = "http://127.0.0.1:8916"
    c = IPPClient(gw)
    s1, b1 = c.get("http://127.0.0.1:8888/")
    assert s1 == 200, f"plain expect 200, got {s1} {b1[:80]}"
    assert b"mock-" in b1, f"body must carry mock marker, got {b1[:80]}"
    # 粘滞确定性证明：country=US 约束下同 session 两次必中 mock-a-us。
    s = IPPClient(gw, session="sdk-selftest-1", country="US")
    _, b2 = s.get("http://127.0.0.1:8888/")
    _, b3 = s.get("http://127.0.0.1:8888/")
    assert b2 == b3 == b"mock-a-us", f"sticky must pin mock-a-us, got {b2[:16]!r} {b3[:16]!r}"
    bad = IPPClient(gw, api_key="bad")
    s4, _ = bad.get("http://127.0.0.1:8888/")
    assert s4 == 403, f"bad key expect 403, got {s4}"
    # D3：无头请求同样 403（门默认开启）。
    nokey = IPPClient(gw, api_key=None)
    s5, _ = nokey.get("http://127.0.0.1:8888/")
    assert s5 == 403, f"missing key expect 403, got {s5}"
    print(f"self-test OK: plain={s1} sticky={b2!r} badkey={s4} nokey={s5}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
        self_test()
    else:
        print(__doc__)
</file>

<file path=".github/workflows/live.yml">
# IPProxyPool live tests (Phase C5): manual only, needs real deps.
# Runs the `-- --ignored` integration tests (Redis + ClickHouse online).
#
# OPT-R6 S3（P0 门禁修复）：本 workflow 此前**结构性不可能通过**，且 SKIP 门未实现。
#   ① ClickHouse service 未挂 `deploy/clickhouse/001_schema.sql`，而全仓 Rust 源码
#      无任何 `CREATE TABLE`（表只由 compose 的 `docker-entrypoint-initdb.d` 创建）
#      ⇒ `ch_sink.rs` 的 `assert_eq!(landed, 1)` 与 `analytics.rs` 的 insert 必失败。
#      修复：挂载 schema 到 CH 的 initdb 目录。
#   ② 文件头宣称「fails on any SKIP line」，但步骤里**无任何断言**；而 4 个文件共
#      10 处 `eprintln!("SKIP ..."); return;` ⇒ 依赖全挂也报绿。
#      修复：测试输出 tee 到文件，随后 grep `^SKIP` 命中即非零退出。
#   ③ ClickHouse service 无 healthcheck（redis 有），CH 就绪通常需 10~20s，
#      测试立即开跑 ⇒ 天然 flaky。修复：补 healthcheck。
name: live

on:
  workflow_dispatch:

jobs:
  live:
    # 与 ci.yml 同口径 pin ubuntu-26.04（迁移窗口 2026-10-19；见 ci.yml gates 注释）。
    runs-on: ubuntu-26.04
    # 依赖真实 CH，冷编译较慢；不设 timeout 以免误杀（门禁失败会自然红）。
    services:
      redis:
        image: redis:7-alpine
        ports: ["6379:6379"]
        # OPT-R4 C6 注记：CI 用无密 service（测试走缺省 URL）；带密 compose
        # 路径由本地 live 验证（export REDIS_URL，见 OPERATION）。
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-retries 10
      clickhouse:
        image: clickhouse/clickhouse-server:24-alpine
        ports: ["8123:8123"]
        env:
          CLICKHOUSE_USER: proxy
          CLICKHOUSE_PASSWORD: "123456"
          CLICKHOUSE_DB: proxy
        # OPT-R6 S3：挂载 schema 到 initdb 目录——这是 `assert_eq!(landed, 1)`
        # 能成立的前提（与 `docker-compose.yml` 的 clickhouse-data 挂载同源）。
        # 另补 healthcheck：CH 冷启动需 10~20s，无探针则测试必在表建好前开跑。
        # OPT-R8 A5：口令经 `CLICKHOUSE_PASSWORD` 容器环境变量传入，不进 argv
        # （`--health-cmd` 的字面量会出现在 `docker inspect` 与进程命令行里）。
        options: >-
          --health-cmd "clickhouse-client --user proxy --password \"$$CLICKHOUSE_PASSWORD\" --query 'SELECT 1'"
          --health-interval 5s
          --health-retries 20
          --health-start-period 10s
        volumes:
          - ${{ github.workspace }}/deploy/clickhouse/001_schema.sql:/docker-entrypoint-initdb.d/001_schema.sql:ro
    defaults:
      run:
        working-directory: gateway
    steps:
      - uses: actions/checkout@v7
      - uses: dtolnay/rust-toolchain@stable
      - name: verify dependencies reachable (no SKIP allowed)
        # 依赖可达性前置断言：PONG/Ok 拿不到就直接红，不进入 cargo test。
        # （测试体内的 SKIP 门在下一步，这里是更早的一道、更易诊断。）
        run: |
          set -euo pipefail
          for i in $(seq 1 30); do
            if redis-cli -h 127.0.0.1 -p 6379 ping 2>/dev/null | grep -q PONG; then break; fi
            [ "$i" = 30 ] && { echo "SKIP-PRECHECK redis never became ready"; exit 1; }
            sleep 2
          done
          for i in $(seq 1 30); do
            if curl -sf -u 'proxy:123456' 'http://127.0.0.1:8123/?query=SELECT%201' | grep -q '^1$'; then break; fi
            [ "$i" = 30 ] && { echo "SKIP-PRECHECK clickhouse never became ready"; exit 1; }
            sleep 2
          done
          # 表必须存在：schema 挂载失败会在这里被抓住，而不是让 cargo test 报一个
          # 语义不明的 assert 失败。
          curl -sf -u 'proxy:123456' \
            'http://127.0.0.1:8123/?query=EXISTS%20TABLE%20proxy.proxy_telemetry_log' | grep -qx '1' \
            || { echo "SKIP-PRECHECK table proxy.proxy_telemetry_log missing (schema not applied)"; exit 1; }
          echo "deps ready"
      - name: live integration tests
        # `tee` 保留完整输出（供 SKIP 门 grep，同时失败时 artifact 可查）。
        # `pipefail` 保证 cargo test 自身的非零退出不被 tee 吞掉。
        run: |
          set -o pipefail
          cargo test --workspace -- --ignored --nocapture 2>&1 | tee live-output.txt
      - name: SKIP gate (any SKIP line fails the run)
        # OPT-R6 S3：把「no SKIP allowed」从注释变成真正的门。
        # 依赖不可达时测试体内会 `eprintln!("SKIP ..."); return;` 静默通过，
        # 没有这道门则「Redis/CH 全挂」= 绿灯。锚定行首 `SKIP` 以免误伤
        # 正常测试输出里恰好含该单词的行；`SKIP-PRECHECK` 已在上一道门拦截。
        run: |
          if grep -qE '^SKIP' live-output.txt; then
            echo "::error::live tests reported SKIP (dependency unreachable) — run is NOT a valid pass"
            grep -nE '^SKIP' live-output.txt
            exit 1
          fi
          echo "no SKIP lines — all live tests really executed"
      - name: upload live output on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: live-output
          path: gateway/live-output.txt
</file>

<file path="deploy/prometheus/prometheus.yml">
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules.yml

# OPT-R5 O9：Alertmanager 接线。**此块早已生效**（此前 docker-compose.yml 里
# 却注释着"取消注释即接线"，属失实注释，OPT-R17 已更正）。
#
# 链路现状（OPT-R17 取证）：
#   Prometheus ──alerting──▶ Alertmanager ──▶ receiver
#                              (默认起)        ("empty" ⇒ 不外发)
#
# 即：**告警已能到达 Alertmanager**（可在其 UI 分组/silence/ack），
# 但**不会外发给人**，因为 deploy/alertmanager.yml 的 receiver 是刻意留空的
# "empty"（避免开发环境误报真实渠道）。要真正收到通知，改那个文件的
# route.receiver 并重启 alertmanager 容器即可，本文件无需改动。
# 详见 docs/OPERATION.md §告警投递。
#
# 注记：顶层键必须是 alerting: 包 alertmanagers:（裸 alertmanagers: 会整库起不来，冒烟实锤已修正）。
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: "pingora-gateway"
    static_configs:
      # OPT-R4 C2：host.docker.internal 仅 Docker Desktop 有效；Linux 生产
      # 把下行改 gateway:9091（容器网关 profile）或宿主 IP:9091（宿主二进制）。
      - targets: ["host.docker.internal:9091"]
    metrics_path: /metrics

  # OPT-R4 C11：redis-exporter（compose profile observability；未跑时
  # target 为 down（无配套告警，只看 /targets），跑起即有序列）。
  - job_name: "redis-exporter"
    static_configs:
      - targets: ["ipproxy-redis-exporter:9121"]
</file>

<file path="deploy/prometheus/rules.yml">
# IPProxyPool Prometheus alert rules (Phase C3, OPT-R4 C9/C11 tuned, OPT-R7 B1/B2 fixed).
#
# OPT-R7 B1 修掉两处 PromQL 语义 bug（原注释保留了病因，便于回溯）：
#   ① TelemetryStreamLagGrowing 对 gauge `redis_stream_length` 用 `increase()`
#      且阈值 `>0` —— 只要有正常遥测流量（stream 在增长）表达式恒为真，
#      `for: 10m` 后**永久 firing**。现改为 `delta()` + 绝对 lag 阈值。
#   ② SupervisorRestarted 缺 `sum by (worker)` —— 聚合后 `worker` 标签消失，
#      annotation 的 `$labels.worker` 渲染成空，无法定位是哪个 worker。
#
# OPT-R7 B2 补三类此前零告警的关键信号：延迟 / 源站熔断 / 遥测丢数。
# 28 个已渲染指标中，此前仅 3 个被规则消费；现补齐后覆盖 9 个。
#
# **指标名口径纪律**：本文件引用的每个指标名都逐个对 `gateway/src/metrics.rs`
# 的 `# HELP` 核对过（OPT-R7 B2 交付时共 28 个）。CI 目前只验 YAML 语法
# （`yaml.safe_load`），**验不出 PromQL 拼写错误**——故此处留此注记，
# 改指标名时必须同步核对。
groups:
  - name: ipp-gateway
    interval: 30s
    rules:
      # ---- 错误率 ----
      # 数据面成功率：2xx / 全部分类。分母含 4xx 拦截（坏 Key/无头属预期行为，
      # 压测坏 Key 会拉低成功率，见 annotation）。
      - alert: GatewaySuccessRateLow
        expr: |
          sum(rate(proxy_requests_total{status="2xx"}[5m]))
          /
          sum(rate(proxy_requests_total[5m]))
          < 0.99
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "网关 5 分钟成功率 < 99%"
          describe: "2xx 占比 {{ $value | humanizePercentage }}；分母含 4xx 拦截，坏 Key 压测属预期拉低。"

      # OPT-R7 B2 新增：上游 403 封禁比。`proxy_requests_forbidden_total` 按
      # provider 分标签（metrics.rs:429），此前只上 Grafana 面板、**无告警**。
      # 403 是熔断的先行指标——配额/IP 封禁会先表现为 403 上升再传导为成功率跌。
      #
      # **标签口径限制（如实标注）**：`proxy_requests_total` **只有 status 标签、
      # 没有 provider 标签**（metrics.rs:404-416），因此算不出真正的
      # per-provider 封禁比（需要按 provider join 总请求数，当前 exposition 做不到）。
      # 本规则退化为「该供应商 403 占**全网**流量的比例」——横向比较各供应商
      # 谁被封禁得最狠仍然有效（Grafana 面板 3 同样受此限制，见 B2 交付注记）。
      # 若将来 `proxy_requests_total` 增加 provider 标签，应立即改为
      # `sum by (provider)(rate(proxy_requests_total[10m]))` 作分母。
      - alert: ProviderForbiddenRatioHigh
        expr: |
          sum by (provider) (rate(proxy_requests_forbidden_total[10m]))
          /
          clamp_min(sum(rate(proxy_requests_total[10m])), 0.001)
          > 0.05
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "供应商 {{ $labels.provider }} 403 占全网流量 > 5%"
          describe: "10 分钟窗内该供应商 403 占全网请求 {{ $value | humanizePercentage }}；查该供应商配额与封禁策略，必要时下调其权重（见 vendor_arbitrage SLA 套利）。注：分母为全网而非该供应商总量（proxy_requests_total 无 provider 标签），故阈值取 5% 而非 20%。"

      # ---- 延迟（OPT-R7 B2 新增）----
      # 依赖 D2 的桶扩展：桶顶此前仅 2500ms 而 peer 超时预算就有 5000/3000ms，
      # >2500ms 全落 +Inf，histogram_quantile 只能外推 —— 慢时 P99 显示好看。
      # 现桶覆盖到 60s，P99 在 5s~30s 区段有真实桶可落。
      # 阈值 5000ms 对齐最坏单跳 connect timeout（gateway.rs build_http_peer）。
      - alert: GatewayLatencyP99High
        expr: |
          histogram_quantile(0.99,
            sum by (le) (rate(gateway_processing_duration_ms_bucket[5m]))
          ) > 5000
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "网关附加延迟 P99 > 5s"
          describe: "5 分钟窗 P99 = {{ $value | humanizeDuration }}；超过最坏单跳 connect timeout，先查上游节点质量（`free_pool_nodes_total` / `quarantine_nodes`）与重试放大。"

      # ---- 免费池健康 ----
      # 免费池水位：30 分钟窗口最大值仍为 0 即干旱。severity 仅 warning——
      # 免费源本就轮转低谷常态 pool=0（见 FREE_BASELINE），此规则抓超长干旱。
      #
      # OPT-R7 B1 修：原式 `max_over_time(free_pool_nodes_total[30m]) == 0` 在
      # `FREE_ENABLED=0`（**缺省**）时该 gauge 恒为 0 ⇒ 缺省配置下永久 firing。
      # 现用 `unless` 排除"指标恒为 0 且从未有过非 0 值"的情形难判——
      # 故改用 `free_pool_source_fetch_ms_count` 作为**启用态代理**：
      # 免费线开启时抓取 worker 必然产生该计数；关闭时恒为 0。
      - alert: FreePoolDry30m
        expr: |
          max_over_time(free_pool_nodes_total[30m]) == 0
          and on() (increase(free_pool_source_fetch_ms_count[30m]) > 0)
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "免费池连续 30 分钟水位 0"
          describe: "免费源轮转低谷属正常；超 30 分钟请查源站存活与熔断 free_pool_source_suspended。（启用态门槛：免费线确实在跑才判干旱，FREE_ENABLED=0 缺省不误报）"

      # OPT-R7 B2 新增：源站熔断。此前 `free_pool_source_suspended{source}`
      # 已渲染但**零规则消费**——规则 2 的 annotation 甚至主动让运维去查它。
      - alert: FreePoolSourceSuspended
        expr: free_pool_source_suspended == 1
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "免费源 {{ $labels.source }} 持续熔断"
          describe: "源站连续多轮零产出被 SourceGuard 熔断（15 分钟未恢复）；查源站是否下线/改版，或临时降低该源权重。"

      # ---- 免费供给 SLO（OPT-R18 P2-3）----
      #
      # 上面两条回答的是"池子空了吗 / 源站活着吗"。它们漏掉的，正是免费池
      # 最常见的两种真实失效：
      #
      #   A. **池里有节点，但出口身份只有一两个。** 几十个节点共用同一个出口
      #      IP 时，`free_pool_nodes_total` 看起来健康，而 WAF 侧看到的只有一个
      #      身份——限流/封禁会瞬间打满全部流量。这就是 `distinct_exit_ips`
      #      与 `nodes_total` 的差值，也是这条指标唯一能回答的问题。
      #   B. **池里有节点，但都是刚进池的。** 中位年龄贴近 0 意味着节点正在
      #      高频死亡+补位（"漏斗"而非"池"），有效吞吐远低于节点数暗示的量。
      #
      # 两条都用 `free_pool_source_fetch_ms_count` 作**启用态门槛**（与
      # FreePoolDry30m 同一手法）：`FREE_ENABLED=0`（缺省）时免费线不跑，
      # 这些 gauge 恒为初始值，没有门槛就会在缺省配置下永久 firing。

      # 出口多样性枯竭：有节点，但不同出口身份 < 3。
      # 阈值取 3 而不是"节点数的一半"：3 是"能扛住单个出口被封"的最低要求，
      # 而比例阈值会随池子大小漂移，读不出绝对含义。
      - alert: FreePoolExitDiversityLow
        expr: |
          free_pool_distinct_exit_ips < 3
          and on() (free_pool_nodes_total > 0)
          and on() (increase(free_pool_source_fetch_ms_count[30m]) > 0)
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "免费池出口多样性枯竭（distinct_exit_ips={{ $value }}）"
          describe: "池内节点共用出口 IP：节点数看似健康，但出口身份不足 3 个。一旦该出口被 WAF 封禁，全部免费流量同时失效。查抓取源是否集中在同一网段/机房。"

      # 年龄中位数塌到接近 0：节点在"高频死亡+补位"，池子是漏斗不是池子。
      # 300s 是经验下限（抓取间隔 + 质检耗时量级），低于它意味着节点活不过
      # 一轮复检。
      #
      # 空池时该 gauge 渲染 **NaN**，而 NaN 参与任何比较都是 false ⇒ 这条
      # 规则在空池下天然不触发（空池由 FreePoolDry30m 负责，两者不重叠）。
      # 这里不写 `>= 0` 之类的护栏：NaN 语义已经覆盖，多写一层反而会让读者
      # 以为负数可能发生。
      - alert: FreePoolAgeCollapse
        expr: |
          free_pool_median_age_seconds < 300
          and on() (free_pool_nodes_total > 0)
          and on() (increase(free_pool_source_fetch_ms_count[1h]) > 0)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "免费池节点年龄中位数 {{ $value | humanizeDuration }}（疑似漏斗式换血）"
          describe: "节点活不过一轮复检，池子在高频死亡+补位；有效吞吐远低于节点数暗示的量。查质检是否过严（free_pool_verify_total）或抓取源质量下降。"

      # 质检转化率坍塌：抓来的原始代理几乎没有能过质检的。
      # 需样本量门槛（1h 内至少 100 次质检），否则启动初期 1/1=0% 会立刻误报。
      # `free_pool_yield_ratio` 无样本时渲染 NaN ⇒ 比较恒 false ⇒ 天然不误报。
      - alert: FreePoolYieldCollapse
        expr: |
          free_pool_yield_ratio < 0.02
          and on() (increase(free_pool_verify_total[1h]) >= 100)
          and on() (increase(free_pool_source_fetch_ms_count[1h]) > 0)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "免费代理质检转化率 {{ $value | humanizePercentage }}（低于 2%）"
          describe: "抓取源产出的原始代理几乎全部质检失败；查源站是否已失效（返回模板页/占位 IP），或出口网络是否整体劣化。"

      # ---- 后台 worker 健康（OPT-R7 B1 修：加 sum by(worker)）----
      # 后台 worker 重启（supervisor 捕获 panic/意外返回后自愈）。
      # Windows 本机调试偶发 tokio 退出抖动（见 EXEC），单次重启是自愈证据；
      # OPT-R4 C9：阈值收紧为 15 分钟窗内 >3 次（抖动不再噪，连续崩才报）。
      # OPT-R7 B1：补 `sum by (worker)` —— 原式对全 worker 求和后再比阈值，
      # 聚合掉 worker 标签使 annotation 的 `$labels.worker` 渲染为空，
      # 告警发出来也定位不到是哪个 worker。现按 worker 独立判定。
      - alert: SupervisorRestarted
        expr: sum by (worker) (increase(supervisor_restarts_total[15m])) > 3
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "后台 worker 频繁重启 ({{ $labels.worker }})"
          describe: "worker={{ $labels.worker }} 在 15 分钟窗内重启 >3 次；先看该 worker 日志。OPT-R6 V1 起 prober/sweep/prewarmer/telemetry 亦纳入监督，telemetry 为有尽监督（崩溃记一次后停止，不自愈）。"

      # 网关抓取失联（内置 up 序列，无需额外指标）。
      - alert: GatewayDown
        expr: up{job="pingora-gateway"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "网关 /metrics 抓取失联超 2 分钟"
          describe: "先看网关进程与看护日志 log/ipp-watchdog.out，再查 :9091 本机直访。"

      # ---- 数据丢失（OPT-R7 B2 新增）----
      # 遥测丢数：两个计数器此前常驻渲染、注释明写"便于 PromQL 告警"，但**零规则**。
      # 遥测静默丢数意味着数仓缺行、SLA 套利基于残缺数据做决策，属静默失效。
      - alert: TelemetryDropped
        expr: increase(telemetry_dropped_total[15m]) > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "遥测落库重试后仍丢弃 {{ $value | printf \"%.0f\" }} 条"
          describe: "flush 写 Redis Stream 失败且重试一次仍失败（15 分钟窗）；查 Redis 可用性与 `supervisor_restarts_total{worker=\"telemetry\"}`。"

      - alert: TelemetryChannelDropped
        expr: increase(telemetry_channel_dropped_total[10m]) > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "遥测通道满/关闭丢弃 {{ $value | printf \"%.0f\" }} 条"
          describe: "mpsc 通道打满（TELEMETRY_CHANNEL_CAP）导致 `try_send` 失败；数据面吞吐超过后台 flush 能力，调大通道容量或排查下游阻塞。"

      # SOCKS 桥出站失败：此前渲染但零规则。
      - alert: SocksBridgeErrorRateHigh
        expr: |
          sum(rate(socks_bridge_errors_total[10m]))
          /
          clamp_min(sum(rate(proxy_requests_total[10m])), 0.001)
          > 0.1
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "SOCKS 桥出站失败率 > 10%"
          describe: "显式 socks 请求的桥接出站失败占比 {{ $value | humanizePercentage }}；查 SOCKS 节点存活（`free_pool_nodes_by_proto{proto=~\"socks4|socks5\"}`）与桥超时配置。"

      # ---- 隔离水位（OPT-R7 B2 新增）----
      # 隔离表无界增长是 OPT-R6 S2（P0）修复前的真实故障模式：sweep 循环死亡
      # 会话/隔离表无界增长至 OOM。OPT-R6 已修根因（饱和减法 + supervisor），
      # 此规则作**回归哨兵**：水位异常升高说明淘汰链路再次失效。
      - alert: QuarantineNodesHigh
        expr: quarantine_nodes > 5000
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "隔离条目水位 {{ $value | printf \"%.0f\" }} 偏高"
          describe: "隔离表（domain:ip 组合）持续偏高，说明大量出口被熔断或淘汰链路失效（OPT-R6 S2 修复目标）；查 CB 消费组 `circuit_breaker_group` 的 pending 与 403 比例。"

      # ---- 遥测 Stream 积压（OPT-R7 B1 修）----
      # 已接线（redis_exporter profile-gated，见 compose）。
      # key 名以网关 telemetry stream 为准（`stream:proxy:telemetry`，见 telemetry.rs）。
      # exporter 未跑时序列缺失，规则静默（inactive），跑起即自动生效。
      #
      # OPT-R7 B1 修两处：
      #   ① `redis_stream_length` 是 **gauge**（当前长度），不是 counter ——
      #      `increase()` 语义上只适用于 counter，对 gauge 求增量是无效的，
      #      改用 `delta()`（gauge 的正确算子）。
      #   ② 阈值从 `> 0` 改为绝对长度 > 1000 —— 原式「有过增长」在系统
      #      **完全健康**时也恒真（正常遥测流量本就在增长 stream），导致永久 firing。
      #      现判「积压确实很大且持续存在」：消费组正常时 stream 会被 XACK 修剪，
      #      稳态长度接近消费速率；持续 >1000 说明消费侧（ch_sink）跟不上。
      - alert: TelemetryStreamBacklogHigh
        expr: |
          max_over_time(redis_stream_length{key="stream:proxy:telemetry"}[10m]) > 1000
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "遥测 Stream 积压持续 > 1000 条"
          describe: "stream 长度 10 分钟内持续超 1000（消费组 ch_sink_group 跟不上）；查 ClickHouse insert 延迟与 `supervisor_restarts_total{worker=\"ch_sink\"}`。注：MAXLEN~100000 修剪策略下健康稳态长度应远低于此值。"

      # ---- 遥测落地端健康（OPT-R15 新增）----
      #
      # 为什么需要这组（实测依据，非推演）：步骤 40 复现过一次**静默丢光全部遥测**的故障——
      # `REDIS_URL` 少写密码，flush 报 `Protocol error: unauthenticated multibulk length`（看着像
      # ClickHouse 报错，实为 **Redis** 协议错误），当时只有翻日志才发现，指标上唯一线索是
      # `telemetry_dropped_total` 在涨：它只说"丢了多少"，**不说是哪一级落地、也不说还通不通**。
      #
      # 三条规则分工（刻意不合并，避免一个阈值同时承担两种语义）：
      #   1. Down      —— 最近一次尝试失败。持续 2m 才报，过滤单次网络毛刺。
      #   2. NeverOk   —— 该 backend 序列存在但 `last_ok=0`，即"试过、一次都没成功过"。
      #   3. Stale     —— `up=1` 但很久没有成功写入（挂起/假活）。必须排除 `last_ok=0`，
      #                    否则「一次都没成功」会被算成"已经 N 百年没写"，两条规则同时误报。
      #
      # 与 `TelemetryStreamBacklogHigh` 的关系：那条依赖 `redis_exporter`（compose 里 profile 门控），
      # **未接 exporter 时静默不发**；本组只依赖网关 `/metrics`，**默认就可用**，是兜底。
      # 两级 backend 互相独立：Redis 好、ClickHouse 坏时 `backend="redis"` 仍为 1，只有 CH 那条转 0。
      - alert: TelemetrySinkDown
        expr: telemetry_sink_up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "遥测落地端 {{ $labels.backend }} 持续失败"
          describe: "backend={{ $labels.backend }} 最近一次写入尝试失败且已持续 2 分钟；遥测正在丢弃（累计 `telemetry_dropped_total`）。按 backend 排查：redis=检查 `REDIS_URL` 是否含密码（密码来自容器启动参数，`docker inspect .Config.Env` 查不到，需看 `.Config.Cmd`）；clickhouse=检查 `CLICKHOUSE_USER`/`CLICKHOUSE_PASSWORD`。"

      - alert: TelemetrySinkNeverSucceeded
        expr: telemetry_sink_last_ok_unixtime_seconds == 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "遥测落地端 {{ $labels.backend }} 从未成功写入过"
          describe: "backend={{ $labels.backend }} 的 `last_ok=0`：序列已出现（说明该级被实际调用过）但**一次都没写成功**。这比 `TelemetrySinkDown` 更严重——不是「曾经好过现在坏了」，而是「从上线起就没通过」，通常是凭据/网络从未配对。"

      - alert: TelemetrySinkStale
        expr: |
          telemetry_sink_last_ok_unixtime_seconds > 0
          and
          (time() - telemetry_sink_last_ok_unixtime_seconds) > 600
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "遥测落地端 {{ $labels.backend }} 已 10 分钟无成功写入"
          describe: "backend={{ $labels.backend }} 的 `up=1` 但最近成功写入距今超 600 秒：假活/挂起（例如 ClickHouse 插入长期卡住而未报错）。注意 `> 0` 条件用于排除「一次都没成功」（由 `TelemetrySinkNeverSucceeded` 负责），否则两条规则会同时误报。"
</file>

