# IPProxyPool 本地开发默认值（Phase C5）。
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略，永不进仓。
# 生产环境务必替换全部密码为强随机值（`openssl rand -hex 24`）。
REDIS_PASSWORD=123456
CLICKHOUSE_USER=proxy
CLICKHOUSE_PASSWORD=123456
CLICKHOUSE_DB=proxy
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-prod
# 步骤 52：Admin API（gateway 容器 :9092）。生产务必改为强随机值；
# 留空则 fail-closed（所有 Admin 请求 401）。
ADMIN_API_KEY=change-me-admin-key
